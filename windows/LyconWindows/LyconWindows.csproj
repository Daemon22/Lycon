<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>LyconWindows</RootNamespace>
    <AssemblyName>LyconWindows</AssemblyName>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <WindowsTargetPlatformVersion>10.0.26100.0</WindowsTargetPlatformVersion>
    <Platforms>x64</Platforms>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <UseWinForms>false</UseWinForms>
    <UseWPF>false</UseWPF>
    <GenerateManifests>false</GenerateManifests>
    <!-- The Windows App SDK 1.7 buildTransitive MrtCore.PriGen.targets imports
         MSIX packaging tasks (ExpandPriContent, RemovePayloadDuplicates) from
         Microsoft.Build.AppxPackage.dll / Microsoft.Build.Packaging.Pri.Tasks.dll.
         These assemblies ship only with Visual Studio / MSIX packaging tools and
         are absent in this environment (dotnet SDK 8 + Windows App SDK 1.7 only).
         Setting EnableCoreMrtTooling=false skips the entire MrtCore.PriGen import,
         which only generates the PRI (resource index) for MSIX packages — not needed
         for a standalone WinExe that loads XAML at runtime via Application.LoadComponent. -->
    <EnableCoreMrtTooling>false</EnableCoreMrtTooling>
    <AppxGeneratePriEnabled>false</AppxGeneratePriEnabled>
    <!-- The Windows App SDK 1.7 markup compiler (both the executable and
         in-proc task) is incompatible with the .NET 8 SDK's MSBuild:
           - XamlCompiler.exe (net472) crashes silently with exit code 1
           - In-proc CompileXaml task uses System.Reflection.Adds.
             MetadataDispenser which throws PlatformNotSupportedException
             on .NET 8 Core runtime
         We disable XAML markup compilation and ship hand-written .g.cs
         files (App.g.cs, MainWindow.g.i.cs) that provide the same
         generated code (Main entry point, InitializeComponent, field
         declarations). -->
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
  </PropertyGroup>

  <ItemGroup>
    <!-- Windows App SDK 1.7 provides WinUI 3 types + CoreWebView2 runtime bootstrap.
         Modern Microsoft.Web.WebView2 (>= 1.0.2802) no longer ships its own
         conflicting Microsoft.UI.Xaml.Controls.WebView2 projection, so there is no CS0433
         type collision. -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.7.250310001" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3405.78" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <!-- XAML files are included as Content (not Page) so the markup compiler
       is skipped. They're copied to the output directory so that
       Application.LoadComponent can resolve ms-appx:/// URIs at runtime. -->
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Remove="**\*.xaml" />
    <Content Include="App.xaml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="MainWindow.xaml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <None Include="Package.appxmanifest" />
  </ItemGroup>

</Project>
